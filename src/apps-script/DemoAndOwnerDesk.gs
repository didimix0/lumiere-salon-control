function _LCDOD_headers_(sh,s){return sh.getRange(s.headerRow,1,1,s.columns.length).getDisplayValues()[0].every(function(v,i){return v===s.columns[i].label;});}function _LCDOD_map_(s){var m={};s.columns.forEach(function(c,i){m[c.name]=i;});return m;}function _LCDOD_row_(s,v){var r=Array(s.columns.length).fill('');s.columns.forEach(function(c,i){if(Object.prototype.hasOwnProperty.call(v,c.name))r[i]=v[c.name];});return r;}function _LCDOD_primitive_(v){return v instanceof Date?v.toISOString():v===null?null:String(v);}function _LCDOD_equal_(a,b){return a.length===b.length&&a.every(function(row,i){return row.length===b[i].length&&row.every(function(value,j){return String(value)===String(b[i][j]);});});}function _LCDOD_report_(valid,status,p,changes){var r={valid:valid,status:status,periodId:p.periodId,expected:p.expected,operations:p.operations,refunds:p.refunds,deskStartRow:p.deskStartRow,blockers:p.blockers,changes:changes};Logger.log(JSON.stringify(r));return r;}
