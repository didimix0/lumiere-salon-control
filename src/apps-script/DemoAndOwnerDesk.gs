function _LCDOD_approvedPartial_(states,schema){var candidate=states.filter(function(x){return x.recordId==='DEMO-OP-001'&&x.state==='partial_or_conflicting';});if(candidate.length!==1)return null;var sourceIndex=_LCDOD_map_(schema).source_system,actual=candidate[0].actual;if(actual[sourceIndex]!=='demo_fixture')return null;return candidate[0];}
function _LCDOD_deskState_(sheet){var start=30,rows=8,range=sheet.getRange(start,1,rows,8),values=range.getDisplayValues(),expected=_LCDOD_deskValues_();if(range.getMergedRanges().length)return{state:'partial_or_conflicting',startRow:start};if(_LCDOD_equal_(values,expected))return{state:'exact_match',startRow:start};return values.every(function(r){return r.every(function(v){return v==='';});})?{state:'absent',startRow:start}:{state:'partial_or_conflicting',startRow:start};}
