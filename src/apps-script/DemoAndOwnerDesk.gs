/** Recovers the approved demo fixture and builds a non-destructive Owner Desk. @return {!Object} */
function LC_recoverDemoAndBuildOwnerDesk() {
  var preflight = _LCDOD_preflight_();
  if (!preflight.valid) return _LCDOD_report_(false, 'demo_recovery_blocked', preflight, []);
  try {
    var changes=[];
    if (preflight.approvedPartial) {
      preflight.operationSheet.deleteRow(preflight.approvedPartial.sheetRowNumber);
      changes.push({sheetName:preflight.operationSchema.sheetName,deletedRow:preflight.approvedPartial.sheetRowNumber,recordId:'DEMO-OP-001'});
      preflight = _LCDOD_preflight_();
      if (!preflight.valid) return _LCDOD_report_(false, 'demo_recovery_blocked_after_approved_delete', preflight, changes);
    }
    if (preflight.operationsToAppend.length) preflight.operationSheet.getRange(preflight.operationSheet.getLastRow() + 1, 1, preflight.operationsToAppend.length, preflight.operationSchema.columns.length).setValues(preflight.operationsToAppend);
    if (preflight.refundsToAppend.length) preflight.refundSheet.getRange(preflight.refundSheet.getLastRow() + 1, 1, preflight.refundsToAppend.length, preflight.refundSchema.columns.length).setValues(preflight.refundsToAppend);
    if (preflight.deskState === 'absent') _LCDOD_buildDesk_(preflight.deskSheet, preflight.deskStartRow);
    SpreadsheetApp.flush();
    changes.push({sheetName:preflight.operationSchema.sheetName,appendedRows:preflight.operationsToAppend.length},{sheetName:preflight.refundSchema.sheetName,appendedRows:preflight.refundsToAppend.length},{sheetName:preflight.deskSchema.sheetName,action:preflight.deskState === 'absent' ? 'created' : 'already_present',range:'A' + preflight.deskStartRow + ':H' + (preflight.deskStartRow + 7)});
    return _LCDOD_report_(true, 'demo_recovery_completed', preflight, changes);
  } catch (error) { return _LCDOD_report_(false, 'demo_recovery_failed', preflight, [{code:'DEMO_RECOVERY_RUNTIME_ERROR',message:String(error.message || error)}]); }
}

function _LCDOD_preflight_() {
