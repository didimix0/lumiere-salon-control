  if (!os || !rs || !ds) blockers.push({code:'DEMO_RECOVERY_SHEET_UNAVAILABLE'});
  if (!blockers.length && (!_LCDOD_headers_(os,op)||!_LCDOD_headers_(rs,rf))) blockers.push({code:'DEMO_RECOVERY_SCHEMA_DRIFT'});
  opStates=blockers.length?[]:_LCDOD_classify_(os,op,expectedOps,'internal_operation_id'); rfStates=blockers.length?[]:_LCDOD_classify_(rs,rf,expectedRefunds,'refund_id');
  var allStates=opStates.concat(rfStates),approvedPartial=_LCDOD_approvedPartial_(opStates,op),unapprovedPartial=allStates.filter(function(x){return x.state==='partial_or_conflicting'&&(!approvedPartial||x.recordId!==approvedPartial.recordId);});
  if (unapprovedPartial.length) blockers.push({code:'DEMO_RECORD_PARTIAL_OR_CONFLICTING',records:unapprovedPartial.map(function(x){return x.recordId;})});
  if (!blockers.length) blockers=blockers.concat(_LCDOD_validateFixture_(os,op,expectedOps),_LCDOD_validateFixture_(rs,rf,expectedRefunds));
  var desk=_LCDOD_deskState_(ds); if (desk.state==='partial_or_conflicting') blockers.push({code:'OWNER_DESK_NO_SAFE_RANGE'});
  return {valid:!blockers.length,blockers:blockers,operationSchema:op,refundSchema:rf,deskSchema:desk,operationSheet:os,refundSheet:rs,deskSheet:ds,operations:opStates,refunds:rfStates,operationsToAppend:opStates.filter(function(x){return x.state==='absent';}).map(function(x){return x.row;}),refundsToAppend:rfStates.filter(function(x){return x.state==='absent';}).map(function(x){return x.row;}),approvedPartial:approvedPartial,deskStartRow:desk.startRow,deskState:desk.state,periodId:'2026-07',expected:{revenue:10900,refunds:500,netRevenue:10400}};
}

function _LCDOD_classify_(sheet,schema,expected,idName){var map=_LCDOD_map_(schema),last=sheet.getLastRow(),values=last>schema.headerRow?sheet.getRange(schema.headerRow+1,1,last-schema.headerRow,schema.columns.length).getValues():[],byId={};values.forEach(function(r,i){var id=String(r[map[idName]]||'');if(!byId[id])byId[id]=[];byId[id].push({row:r,sheetRowNumber:schema.headerRow+1+i});});return expected.map(function(row){var id=String(row[map[idName]]),found=byId[id]||[];if(!found.length)return{recordId:id,state:'absent',row:row};if(found.length!==1)return{recordId:id,state:'partial_or_conflicting',row:row,duplicateRecordCount:found.length};return _LCDOD_sameRow_(found[0].row,row)?{recordId:id,state:'exact_match',row:row,sheetRowNumber:found[0].sheetRowNumber}:{recordId:id,state:'partial_or_conflicting',row:row,sheetRowNumber:found[0].sheetRowNumber,actual:found[0].row.map(_LCDOD_primitive_)};});}
