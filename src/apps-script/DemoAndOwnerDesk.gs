function _LCDOD_buildDesk_(sheet,row){var values=_LCDOD_deskValues_();sheet.getRange(row,1,8,8).setValues(values);sheet.getRange(row,1,1,8).setBackground('#1f2937').setFontColor('#ffffff').setFontWeight('bold').setFontSize(16);sheet.getRange(row+3,1,1,6).setBackground('#e5e7eb').setFontWeight('bold');sheet.getRange(row+4,1,1,4).setBackground('#fef3c7');sheet.getRange(row+2,1,1,8).setBackground('#fef3c7').setFontColor('#92400e');}
function _LCDOD_operations_(s){var base={source_system:'demo_fixture',source_type:'Ручной ввод',duplicate_status:'Уникальная',validation_status:'Корректна'};return [['DEMO-OP-001','2026-07-05','Выполнена','DEMO-SVC-HAIR','DEMO-MASTER-01',1,3000,3000,true],['DEMO-OP-002','2026-07-12','Выполнена','DEMO-SVC-COLOR','DEMO-MASTER-02',1,6000,5400,true],['DEMO-OP-003','2026-07-17','Выполнена','DEMO-SVC-NAIL','DEMO-MASTER-01',1,2500,2500,true],['DEMO-OP-004','2026-07-22','Отменена','DEMO-SVC-HAIR','DEMO-MASTER-01',1,2800,0,false]].map(function(x){var v={internal_operation_id:x[0],operation_date:new Date(x[1]+'T00:00:00'),operation_status:x[2],service_id:x[3],master_id:x[4],quantity:x[5],list_price:x[6],charged_amount:x[7],included_in_calculation:x[8]};Object.keys(base).forEach(function(k){v[k]=base[k];});return _LCDOD_row_(s,v);});}
