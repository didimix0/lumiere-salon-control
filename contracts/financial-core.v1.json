  "sourceOfTruth": ["docs/FINANCIAL_LOGIC.md", "docs/SALON_ECONOMICS.md", "docs/DATA_MODEL.md", "docs/MVP_SCOPE.md", "docs/adr/0002-plan-fact-and-conditional-cash-module.md", "docs/adr/0006-period-close-adjustments-and-history.md"],
  "invariants": [
    "closed actual, current preliminary and forecast are distinct classifications",
    "accrual operating profit, cash balance and owner-withdrawable amount are distinct",
    "discount is an actual reduction of price, not lost profit",
    "refund keeps the original operation and is linked to it",
    "period input completeness is explicit; empty incomplete sources are not zero activity",
    "no-show without confirmed actual damage is an opportunity",
    "chair-renter client revenue is excluded from salon revenue",
    "weighted metrics use actual volumes",
    "financial formulas are independent from UI and Apps Script orchestration",
    "actual owner-master pay under the active scheme is operating labour expense; owner draw is separate",
    "explicitly identified tips are transit amounts and never service revenue, operating profit, service margin, or master-pay base",
    "refunds and cancellations do not automatically reverse material cost"
  ],
  "approvedPolicyDecisions": {
    "FC-01": "actual owner-master pay follows the active scheme as operating labour expense; owner draw is separate; unpaid owner labour is not normalised in MVP",
    "FC-02": "only explicitly identified tips are transit; ambiguous amounts create a controlled exception or warning",
    "FC-03": "material cost remains after refund or cancellation unless a separate audited manual material adjustment exists",
    "FC-04": "period input completeness is explicit and auditable; a closed period requires complete input status"
  },
  "runtimePlan": {
    "iteration": 4,
    "mode": "read_only_formula_plan",
    "sourceSchemas": ["OPERATIONS", "REFUNDS", "SYS_PERIODS"],
    "metrics": [
      {"metricCode":"gross_list_service_value","formula":"SUM(quantity * list_price for completed included services)"},
      {"metricCode":"recognized_service_revenue_before_refunds","formula":"SUM(charged_amount for completed included services)"},
      {"metricCode":"total_service_discounts","formula":"SUM(MAX(quantity * list_price - charged_amount; 0) for completed included services)"},
      {"metricCode":"net_service_revenue","formula":"recognized_service_revenue_before_refunds - SUM(refund_amount for included linked refunds in refund period)"}
    ],
    "writes": "forbidden"
  },
